		[5] = {
			[1] = {"S?頲 phong l? T?L穙 M玭 Nh﹏.<enter>H鋍 頲 v?c玭g: L玦 K輈h thu藅<enter>N琲 ti誴 nh薾 nhi謒 v? Л阯g Nh祅.<enter>C竎 bc th鵦 hi謓 nhi謒 v?enter><color=red>Bc 1:<color> дn ph遪g 竚 kh?(504/317) g苝 Л阯g Nh祅, nh薾 nhi謒 v?truy t譵 b?k輕 b?m蕋.<enter><color=red>Bc 2:<color> дn ph遪g Ngh?s?(507/319) g苝 Л阯g Nh蕋 Tr莕 , bi誸 頲 c?2 k?ng kh?nghi.<enter><color=red>Bc 3:<color> дn Th祅h Й -> th玭 Giang T﹏, g苝 Л阯g Nguy猲 (430/385). Л阯g Nguy猲 cho bi誸  th蕐 Л阯g H遖  甶 n Hng Th駓 Йng.<enter><color=red>Bc 4:<color> дn Th祅h Й -> Thanh Th祅h S琻 -> Hng Th駓 ng (214/242) n籱 ?c鵦 t﹜ c馻 n骾 Thanh Th祅h. V祇 ng nh b筰 Л阯g H遖 (234/207), bi誸 頲 竚 Kh?ph?產ng gi蕌 trong s琻 ng.<enter><color=red>Bc 5:<color> Цnh b筰 c竎 t猲 ng ng c馻 Л阯g H遖 l? Thi誸 Quy襫 Di謒 La (232/210; 214/203; 224/201; 246/204) ho芻 Thi誸 Ch飝 Ma Qu﹏ (217/205; 234/200). Цnh b筰 b鋘 ch髇g s?l蕐 l筰 頲 竚 Kh?ph?(X竎 su蕋 50%).<enter><color=red>Bc 6:<color> Tr?l筰 ph遪g 竚 kh? giao 竚 Kh?ph?cho Л阯g Nh祅 , ho祅 th祅h nhi謒 v?"},
			[2] = {"G苝 Л阯g Nh祅","дn ph遪g 竚 kh?(504,317) g苝 Л阯g Nh祅, nh薾 nhi謒 v?truy t譵 b?k輕 b?m蕋.",0,1,29,1599,3203},
