		[6] = {
			[1] = {"S?頲 phong l? Thi猲 Th?Th莕 V?<enter>N琲 ti誴 nh薾 nhi謒 v? Chng M玭 Л阯g C鰑.<enter>C竎 bc th鵦 hi謓 nhi謒 v?enter><color=red>Bc 1:<color> дn Ph遪g kh竎h (508,322) g苝 Chng m玭 Л阯g C鮱 , nh薾 nhi謒 v?thu h錳 Th蕋 Tinh Tuy謙 M謓h Ki誱.<enter><color=red>Bc 2:<color> дn Tr骳 T?ng (523,326) (甶 c鯽 b猲 ph秈 c馻 Л阯g M玭).<enter><color=red>Bc 3:<color> T筰 t莕g 1 nh b筰 t猲 M穘g H竛 u L躰h (189,205; 185,204; 190,202; 192,200; 197,201) s?l蕐 頲 ch譨 kho?t莕g 2.<enter><color=red>Bc 4:<color> T筰 t莕g 2 nh b筰 Tinh H?(194,198; 197,201) s?l蕐 頲 ch譨 kho?l猲 t莕g 3.<enter><color=red>Bc 5:<color> L猲 t莕g 3 c?2 rng: tr猲 v?di (1 ch鴄 ti襫, 1 ch鴄 箃 H錸 Ki誱). Ch鋘 rng ?tr猲 s?l蕐 頲 Th蕋 Tinh Tuy謙 M謓h Ki誱.<enter><color=red>Bc 6:<color> V?giao ki誱 cho Chng m玭 Л阯g C鮱 l?ho祅 th祅h nhi謒 v? C遪 n誹 ch鋘 nh莔 rng ch鴄 ti襫 th?v?g苝 Chng m玭 Л阯g C鮱 n閜 ph箃 4 v筺 lng r錳 l祄 l筰 nhi謒 v?<enter><color=red>L璾 ?<color><enter>N誹  l猲 頲 t莕g 2 r錳 m?b?ch誸 th?khi v祇 ng l筰 c?vi謈 l猲 t莕g 2, kh玭g c莕 nh l筰 ?t莕g 1."},
			[2] = {"G苝 Chng m玭 Л阯g C鮱","дn Ph遪g kh竎h (508,322) g苝 Chng m玭 Л阯g C鮱 , nh薾 nhi謒 v?thu h錳 Th蕋 Tinh Tuy謙 M謓h Ki誱.",0,1,33,1617,3191},
			[3] = {"Цnh b筰 t猲 M穘g H竛 u L躰h","T筰 t莕g 1 Tr骳 T?ng nh b筰 t猲 M穘g H竛 u L躰h s?l蕐 頲 ch譨 kho?t莕g 2",1,1,26,1512,3290},
			[4] = {"S?d鬾g ch譨 kh鉧 l猲 t莕g 2","S?d鬾g ch譨 kh鉧 v鮝 l蕐 頲 t?M穘g H竛 u L躰h m?ra l鑙 l猲 t莕g 2 Tr骳 T?чng.",1,1,26,1597,3216},
			[5] = {"Цnh b筰 Tinh H?,"T筰 t莕g 2 nh b筰 Tinh H?(194,198; 197,201) s?l蕐 頲 ch譨 kho?l猲 t莕g 3",1,0,27,194,198},
			[6] = {"S?d鬾g ch譨 kh鉧 l猲 t莕g 3","S?d鬾g ch譨 kh鉧 v鮝 l蕐 頲 t?Tinh H?m?ra l鑙 l猲 t莕g 3 Tr骳 T?чng. Ch鋘 rng ?tr猲.",1,1,27,1602,3210},
			[7] = {"G苝 Chng m玭 Л阯g C鮱","V?giao ki誱 cho Chng m玭 Л阯g C鮱 l?ho祅 th祅h nhi謒 v? ",0,1,33,1617,3191},
		},
		[7] = {
			[1] = {"Y猽 c莡: ngi ch琲  xu蕋 s? ng c蕄 tr猲 60, ch璦 gia nh藀 bang ph竔 n祇, c?th?n g苝 trng m玭 c馻 ph竔 giao 5 v筺 lng  tr飊g ph秐 s?m玭. T? v?sau c?th?t飝 ?ra v祇 s?m玭.<enter>Ph莕 Thu雗g:<enter>Ti觰 L?Phi o<enter>T竛 Hoa Ti猽<enter>Thi猲 La мa V鈔g<enter>T﹎ Nh穘<enter>Л頲 phong l祄: L鬰 C竎 Trng L穙."},
		},
		[8] = {
			[1] = {"Y猽 c莡: T?c蕄 90 tr?l猲, danh v鋘g tr猲 240 甶觤, l?Л阯g M玭 k?danh  t? trc m総 ch璦 gia nh藀 m玭 ph竔 n祇.<enter>Ph莕 thng:<enter>Nhi誴 H錸 Nguy謙 秐h<enter>C鰑 Cung Phi T輓h<enter>B筼 V?L?Hoa<enter>Lo筺 Ho祅 K輈h<enter>Danh v鋘g 頲 30 甶觤. (T蕋 c?c竎 m玭 ph竔 kh竎 u c?th?l祄 nhi謒 v?n祔  nh薾 ph莕 thng 甶觤 danh v鋘g, nh璶g kh玭g h鋍 頲 chi猽 th鴆)<enter>C竎 bc th鵦 hi謓 nhi謒 v?enter><color=red>Bc 1: <color>дn Th祅h Й -> th玭 Giang T﹏, g苝 Л阯g Nguy猲 (430,385), bi誸 頲 Л阯g B蕋 Nhi詍 c?nh鱪g d蕌 hi謚 b蕋 thng v?b筺 quy誸 t﹎ t譵 hi觰 cho c苙 k?m鋓 vi謈.<enter><color=red>Bc 2: <color>дn Л阯g M玭 t筰 ph遪g T?t?ph遪g (513,317), g苝 Л阯g B蕋 Nhi詍... H緉 nh?b筺 chuy觧 d飉 1 b鴆 th?<enter><color=red>Bc 3: <color>дn Bi謓 Kinh g苝 B筩h C玭g T?(207,191) giao th? H緉 c th?m閠 h錳 r錳 giao l筰 cho b筺 1 b鴆 th?h錳 ﹎.<enter><color=red>Bc 4: <color>Quay l筰 Л阯g M玭 giao th?cho Л阯g B蕋 Nhi詍 . Цnh b筰 Л阯g B蕋 Nhi詍, nh薾 quy觧 s竎h Л阯g M玭 Tuy謙 H鋍 M藅 T辌h. (L璾 ? n誹 nh?trong l骳 nh, b筺 c?b?t?thng, b筺 v蒼 c?th?v祇 nh ti誴, m竨 c馻 Л阯g B蕋 Nhi詍 v蒼 b?m蕋 nh?th阨 甶觤 b筺 ch誸).<enter><color=red>Bc 5: <color>дn Bi謓 Kinh -> Thi猲 Nh蒼 gi竜 -> t莕g 1 -> t莕g 2 -> t莕g 3 g苝 an M閏 Du?(225,199) giao s竎h. an M閏 Du?l筰 nh?b筺 g鰅 l阨 n Л阯g B蕋 Nhi詍.<enter><color=red>Bc 6: <color>Quay l筰 Л阯g M玭 g苝 Л阯g B蕋 Nhi詍, ho祅 th祅h nhi謒 v?<enter>L璾 ?<enter>N誹  l猲 頲 t莕g 2 r錳 m?b?ch誸 th?khi v祇 ng l筰 c?vi謈 l猲 t莕g 2, kh玭g c莕 nh l筰 ?t莕g 1."},
			[2] = {"G苝 Л阯g Nguy猲","дn th玭 Giang T﹏, g苝 Л阯g Nguy猲, bi誸 頲 Л阯g B蕋 Nhi詍 c?nh鱪g d蕌 hi謚 b蕋 thng v?b筺 quy誸 t﹎ t譵 hi觰 cho c苙 k?m鋓 vi謈.",0,1,20,3444,6169},
			[3] = {"G苝 Л阯g B蕋 Nhi詍","дn Л阯g M玭 t筰 ph遪g T?t?ph遪g, g苝 Л阯g B蕋 Nhi詍... H緉 nh?b筺 chuy觧 d飉 1 b鴆 th?",0,1,36,1595,3189},
			[4] = {"G苝 B筩h C玭g T?,"дn Bi謓 Kinh g苝 B筩h C玭g T?giao th? H緉 c th?m閠 h錳 r錳 giao l筰 cho b筺 1 b鴆 th?h錳 ﹎.",0,1,37,1656,3062},
			[5] = {"Giao th?cho Л阯g B蕋 Nhi詍","Quay l筰 Л阯g M玭 giao th?cho Л阯g B蕋 Nhi詍 . Цnh b筰 Л阯g B蕋 Nhi詍, nh薾 quy觧 s竎h Л阯g M玭 Tuy謙 H鋍 M藅 T辌h.",0,1,36,1595,3189},
			[6] = {"G苝 an M閏 Du?,"дn Thi猲 Nh蒼 gi竜 t莕g 3 g苝 an M閏 Du?giao s竎h. an M閏 Du?l筰 nh?b筺 g鰅 l阨 n Л阯g B蕋 Nhi詍.",0,0,49,225,199},
			[7] = {"G苝 Л阯g B蕋 Nhi詍","Quay l筰 Л阯g M玭 g苝 Л阯g B蕋 Nhi詍, ho祅 th祅h nhi謒 v?",0,1,36,1595,3189},
		},
		[9] = {
			[1] = {"M藅 t辌h k?n╪g 120 c?th?i t筰 chng m玭. <enter>V藅 ph萴 c莕 thi誸  i:<enter>1 quy觧 B祅 Nhc T﹎ Kinh, 1 b?s竎h k?n╪g 90 c馻 m玭 ph竔 m譶h, 1 vi猲 Tinh H錸g B秓 Th筩h v?1 vi猲 Th駓 Tinh."},
