function helpgoldquest()
	if GetLevel() < 20 then
		Msg2Player("<color=yellow>H穣 t n c蕄 20 h穣 s?d鬾g ch鴆 n╪g n祔")
		return
	end
	local tb = {
	"Ch輓h tuy課/#gquest(1)",
	"Ph?tuy課/#gquest(2)",
	"Quay l筰./hotrolamnvhoangkim",
	"Tho竧./Quit",
	}
	Say("",getn(tb),tb)
end
function gquest(ID)
	local MissType = ID --Lo筰 nv ch輓h hay ph?tuy猲. Ch輓h l?1 ph?l?2
	local tb = {
	"Ch輓h ph竔 - B?m藅 T莔 Long H閕/#gquest_step1("..MissType..",1)",
	"Trung l藀 - C﹗ chuy謓 L﹎ Uy猲 Nhai/#gquest_step1("..MissType..",2)",
	"T?ph竔 - Long kh?chi ho?#gquest_step1("..MissType..",3)",
	"Quay l筰/character",
	"K誸 th骳 i tho筰/Quit"
	}
	Say("",getn(tb),tb)
end
function gquest_step1(ID1,ID2)
	local MissType = ID1 --Lo筰 NV ch輓h hay ph?
	local PheType = ID2 --Nhi謒 v?ch輓h - trung - t?
	if MissType == 1 then --ch輓h tuy課
		local tab_Content = {
		"Ch輓h tuy課 c蕄 20/#gquest_step2("..MissType..","..PheType..",1)",
		"Ch輓h tuy課 c蕄 30/#gquest_step2("..MissType..","..PheType..",2)",
		"Ch輓h tuy課 c蕄 40/#gquest_step2("..MissType..","..PheType..",3)",
		"Ch輓h tuy課 c蕄 50/#gquest_step2("..MissType..","..PheType..",4)",
		"Ch輓h tuy課 c蕄 60/#gquest_step2("..MissType..","..PheType..",5)",
		"Quay l筰/character",
		"K誸 th骳 i tho筰/Quit"
		}
		Say("H?tr?l祄 nhi謒 v?ho祅g kim Ch輓h Tuy課. ", getn(tab_Content), tab_Content);
	elseif MissType == 2 then --ph?tuy課
		local tab_Content = {
		"Ph?tuy課 c蕄 20 - 29/#gquest_step2("..MissType..","..PheType..",1)",
		"Ph?tuy課 c蕄 30 - 39/#gquest_step2("..MissType..","..PheType..",2)",
		"Ph?tuy課 c蕄 40 - 49/#gquest_step2("..MissType..","..PheType..",3)",
		"Ph?tuy課 c蕄 50 - 59/#gquest_step2("..MissType..","..PheType..",4)",
		"Quay l筰/character",
		"K誸 th骳 i tho筰/Quit"
		}
		Say("H?tr?l祄 nhi謒 v?ho祅g kim Ch輓h Tuy課. ", getn(tab_Content), tab_Content);
	end
end
function gquest_step2(ID1,ID2,ID3)
	local Uworld1061 = nt_getTask(1061)
	local MissType = ID1 --Lo筰 NV ch輓h hay ph?
	local PheType = ID2 --Nhi謒 v?ch輓h - trung - t?
	local CapDo = ID3
	local strDesc = tb_HelpGoldQuest[MissType][PheType][CapDo][1][1]
	local tbOpt = {}
	local TotalSelect = getn(tb_HelpGoldQuest[MissType][PheType][CapDo]) --T鎛g c閚g c?bao nhi猽 l鵤 ch鋘.
	for i=1,TotalSelect do
		local FightState = tb_HelpGoldQuest[MissType][PheType][CapDo][i][2]
		local MapId = tb_HelpGoldQuest[MissType][PheType][CapDo][i][4]
		local nX =tb_HelpGoldQuest[MissType][PheType][CapDo][i][5]
		local nY = tb_HelpGoldQuest[MissType][PheType][CapDo][i][6]
		tinsert(tbOpt, {tb_HelpGoldQuest[MissType][PheType][CapDo][i][1],gquest_step3,{FightState,MapId,nX,nY}})
	end
	if ( Uworld1061 == 40 ) or ( Uworld1061 == 50 ) then
		if MissType == 2 and CapDo == 4 then 
			Msg2Player("Цp 竛 T鑞g Kim: <color=yellow>AC ABC ABAC CAB<color>")
		end
	end
	tinsert(tbOpt, {"Quay l筰",gquest_step1})
	tinsert(tbOpt, {"Tho竧."})
	CreateNewSayEx(strDesc, tbOpt);
end
function gquest_step3(ID1,ID2,ID3,ID4)
	local FightState = ID1
	local MapId = ID2
	local nX = ID3
	local nY = ID4
	NewWorld(MapId,nX,nY)
	SetFightState(FightState)
end
