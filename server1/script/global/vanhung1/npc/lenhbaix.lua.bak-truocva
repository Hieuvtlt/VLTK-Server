			[5] = {"Цnh b筰 Л阯g H遖","дn Th祅h Й -> Thanh Th祅h S琻 -> Hng Th駓 ng (214,242) n籱 ?c鵦 t﹜ c馻 n骾 Thanh Th祅h. V祇 ng nh b筰 Л阯g H遖 (234,207), bi誸 頲 竚 Kh?ph?產ng gi蕌 trong s琻 ng.",1,0,24,234,207},
