function help_quest()
	local nFaction = GetLastFactionNumber()
	if nFaction < 0 then
		Msg2Player("Xin h穣 gia nh藀 m玭 ph竔 r錳 m韎 s?d鬾g ch鴆 n╪g n祔!")
		return
	elseif nFaction == 0 then
		TenMP = "Thi誹 L﹎"
	elseif nFaction == 1 then
		TenMP = "Thi猲 Vng"
	elseif nFaction == 2 then
		TenMP = "Л阯g M玭"
	elseif nFaction == 3 then
		TenMP = "Ng?чc"
	elseif nFaction == 4 then
		TenMP = "Nga My"
	elseif nFaction == 5 then
		TenMP = "Th髖 Y猲"
	elseif nFaction == 6 then
		TenMP = "C竔 Bang"
	elseif nFaction == 7 then
		TenMP = "Thi猲 Nh蒼"
	elseif nFaction == 8 then
		TenMP = "V?ng"
	elseif nFaction == 9 then
		TenMP = "C玭 L玭"
	elseif nFaction == 10 then
		TenMP = "Hoa S琻"
	end
	if TenMP == "Hoa S琻" then
		return Msg2Player("<color=yellow>Hi謓 t筰 ch璦 ho祅 th祅h nhi謒 v?Hoa S琻<color>")
	end
	local tab_Content = {
		"Nhi謒 v?c蕄 10 "..TenMP.."/#help_quest_step1("..nFaction..",1,2,"..getn(tb_HelpQuest[nFaction][1])..")",
		"Nhi謒 v?c蕄 20 "..TenMP.."/#help_quest_step1("..nFaction..",2,2,"..getn(tb_HelpQuest[nFaction][2])..")",
		"Nhi謒 v?c蕄 30 "..TenMP.."/#help_quest_step1("..nFaction..",3,2,"..getn(tb_HelpQuest[nFaction][3])..")",
		"Nhi謒 v?c蕄 40 "..TenMP.."/#help_quest_step1("..nFaction..",4,2,"..getn(tb_HelpQuest[nFaction][4])..")",
		"Nhi謒 v?c蕄 50 "..TenMP.."/#help_quest_step1("..nFaction..",5,2,"..getn(tb_HelpQuest[nFaction][5])..")",
		"Nhi謒 v?Xu蕋 S?"..TenMP.."/#help_quest_step1("..nFaction..",6,2,"..getn(tb_HelpQuest[nFaction][6])..")",
		"Nhi謒 v?Tr鮪g Ph秐 S?M玭 "..TenMP.."/#help_quest_step1("..nFaction..",7,2,"..getn(tb_HelpQuest[nFaction][7])..")",
		"Nhi謒 v?c蕄 90 "..TenMP.."/#help_quest_step1("..nFaction..",8,2,"..getn(tb_HelpQuest[nFaction][8])..")",
		"K?n╪g 120 "..TenMP.."/#help_quest_step1("..nFaction..",9,2,"..getn(tb_HelpQuest[nFaction][9])..")",
		"K?danh  t?"..TenMP.."/#help_quest_step1("..nFaction..",10,2,"..getn(tb_HelpQuest[nFaction][10])..")",
		"Quay l筰/character",
		"K誸 th骳 i tho筰/Quit"
		}
		Say("H?tr?t﹏ th?l祄 nhi謒 v?m玭 ph竔. Xin h穣 c?g緉g ho祅 th祅h nhi謒 v?m玭 ph竔 r錳 m韎 gia nh藀 bang h閕 tung ho祅h giang h? ", getn(tab_Content), tab_Content);
end
function help_quest_step1(nFaction,nIDQ,nX,nY)
	local strDesc = tb_HelpQuest[nFaction][nIDQ][1][1]
	if (not nX) then
		nX1 = 2;
		nY1 = 10;
	else
		nX1 = nX;
		nY1 = nY;
	end
	if (nY1 - nX1 > 9) then
		nY1 = nX1 + 9;
	end
	if nIDQ == 1 then
		TenNV = "Nhi謒 v?c蕄 10"
	elseif nIDQ == 2 then
		TenNV = "Nhi謒 v?c蕄 20"
	elseif nIDQ == 3 then
		TenNV = "Nhi謒 v?c蕄 30"
	elseif nIDQ == 4 then
		TenNV = "Nhi謒 v?c蕄 40"
	elseif nIDQ == 5 then
		TenNV = "Nhi謒 v?c蕄 50"
	elseif nIDQ == 6 then
		TenNV = "Nhi謒 v?Xu蕋 S?
	elseif nIDQ == 7 then
		TenNV = "Nhi謒 v?Tr鮪g Ph秐 S?M玭"
	elseif nIDQ == 8 then
		TenNV = "Nhi謒 v?c蕄 90"
	elseif nIDQ == 9 then
		TenNV = "K?n╪g 120"
	elseif nIDQ == 10 then
		TenNV = "K?danh  t?
	end
	local tbOpt = {}
	local TotalSelect = getn(tb_HelpQuest[nFaction][nIDQ])
	for i=nX1,nY1 do
		local FightState = tb_HelpQuest[nFaction][nIDQ][i][3]
		local TypeMove = tb_HelpQuest[nFaction][nIDQ][i][4] --Ban u m譶h l祄 ph莕 to?畂?l?ki觰 nh?game v?d?271 - 291 nh璶g to? n祔 n?ph?kh玭g ch輓h x竎 n猲 v?sau  h誸 sang to? ki觰 4 s? TypeMove lu玭 l?1
		local MapId = tb_HelpQuest[nFaction][nIDQ][i][5]
		local nX =tb_HelpQuest[nFaction][nIDQ][i][6]
		local nY = tb_HelpQuest[nFaction][nIDQ][i][7]
		tinsert(tbOpt, {tb_HelpQuest[nFaction][nIDQ][i][1],help_quest_step2,{FightState,TypeMove,MapId,nX,nY,TenMP,TenNV,tb_HelpQuest[nFaction][nIDQ][i][2],tb_HelpQuest[nFaction][nIDQ][i][1]}})
	end
	if (nX1 ~= 2) then
		tinsert(tbOpt,{"Trang trc",help_quest_step1,{nFaction,nIDQ,2,nX1-1}});
	end
	if (nY1 < TotalSelect) then
		tinsert(tbOpt,{"Trang sau",help_quest_step1,{nFaction,nIDQ,nY1+1,TotalSelect}});
	end
	tinsert(tbOpt, {"Quay l筰",help_quest})
	tinsert(tbOpt, {"Tho竧."})
	CreateNewSayEx(strDesc, tbOpt);
end
function help_quest_step2(FightState,TypeMove,MapId,nX,nY,MonPhai,NhiemVu,BuocThucHien,NoiDungNhiemVu)
	if TypeMove == 0 then
		NewWorld(MapId,nX*8,nY*16) --
	else
		NewWorld(MapId,nX,nY) --
	end
	SetFightState(FightState)
	Msg2Player("ng th鵦 hi謓 <color=yellow>"..NhiemVu.."<color> m玭 ph竔 <color=yellow>"..MonPhai.."<color>. N閕 dung nhi謒 v? <color=green>"..NoiDungNhiemVu.."<color>")
	AddNote("N閕 dung nhi謒 v? <color=green>"..BuocThucHien.."<color>")
end
