	[5] = { --Thuy yen OK
		[1] = {
			[1] = {"S?頲 phong l? Tam Ph萴 Hoa S? H鋍 頲 v?c玭g: Th髖 Y猲 o Ph竝, Th髖 Y猲 Song o. N琲 ti誴 nh薾 nhi謒 v? Ch?ph遪g, Chng m玭 Do穘 H祄 Y猲.\n<color=red>Bc 1<color>: дn Ch?ph遪g <color=yellow>(35/75)<color> g苝 Chng m玭 Do穘 H祄 Y猲 , ti誴 nh薾 nhi謒 v?truy t譵 c﹜ Tr﹎ b?th蕋 l筩.\n<color=red>Bc 2<color>: дn khu r鮪g ph輆 Йng c馻 Thu?Y猲, b筺 h穣 nh nh鱪g con H錸g H?(C竜 ) <color=yellow>(83/105; 90/99; 82/ 99; 87/ 97)<color> l蕐 頲 Th髖 V?Tr﹎.\n<color=red>Bc 3<color>: Mang Th髖 V?Tr﹎ v?giao cho Chng m玭 Do穘 H祄 Y猲, ho祅 th祅h nhi謒 v?"},
