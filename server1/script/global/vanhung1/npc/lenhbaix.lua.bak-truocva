function GotoBLH()
	local nW, nX, nY = GetWorldPos();
	if (nW == 246) then
	Msg2Player("Map n祔 kh玭g th?s?d鬾g t輓h n╪g n祔!")
	return 1
	end
	if (nW == 53) then
		SetPos(1626,3179);
	else
		NewWorld(53, 1626, 3179);
	end
	SetFightState(0);
	Msg2Player("Di chuy觧 v?<color=green>Ba L╪g Huy謓<color> th祅h c玭g!")
end

