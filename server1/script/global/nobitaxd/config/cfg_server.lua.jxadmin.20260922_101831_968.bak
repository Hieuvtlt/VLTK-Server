-- 0 = chay theo thang that. 1..12 = EP MO thang do de test, bat ke hom nay la thang may.

SKN_THANG_TEST = 0

-- Cong duy nhat moi noi trong nhanh su kien nam deu hoi qua. Tra 1 = dang mo, 0 = dong.
function SKN_ThangMo(nThang)
	if CFG_SuKienNam ~= 1 then return 0 end

	local tbCo = {CFG_SuKienT1, CFG_SuKienT2, CFG_SuKienT3, CFG_SuKienT4,
				  CFG_SuKienT5, CFG_SuKienT6, CFG_SuKienT7, CFG_SuKienT8,
				  CFG_SuKienT9, CFG_SuKienT10, CFG_SuKienT11, CFG_SuKienT12}
	if tbCo[nThang] ~= 1 then return 0 end

	local nNay = SKN_THANG_TEST
	if nNay == 0 then nNay = tonumber(GetLocalDate("%m")) end
	if nNay ~= nThang then return 0 end
	return 1
end
