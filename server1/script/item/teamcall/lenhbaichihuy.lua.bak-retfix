function LenhBaiChiHuy_CallNow()
	if (LeaderToken_IsLeader() ~= 1) then LeaderToken_Revoke(); return; end;
	local nRet = TeamCall_CallNow();
	if (nRet == nil or nRet < 0) then
		Msg2Player("<color=red>Kh«ng gäi ®­îc. KiÓm tra l¹i tæ ®éi.<color>");
	else
		Msg2Player("<color=yellow>§· kÐo " .. nRet .. " ®ång ®éi vÒ.<color>");
	end;
end;

function LenhBaiChiHuy_EnableAsk()
	if (LeaderToken_IsLeader() ~= 1) then LeaderToken_Revoke(); return; end;
	AskClientForNumber("LenhBaiChiHuy_EnableDo", TEAM_CALL_MIN_DISTANCE, TEAM_CALL_MAX_DISTANCE,
		"Ph¹m vi bao nhiªu «? (10 - 100)");
end;

function LenhBaiChiHuy_EnableDo(nDistance)
	if (LeaderToken_IsLeader() ~= 1) then LeaderToken_Revoke(); return; end;
	local nRet = TeamCall_EnablePermanent(nDistance, 0);
	if (nRet == 1) then
		Msg2Player("<color=yellow>§· bËt gäi tù ®éng, ph¹m vi " .. TeamCall_GetDistance() .. " «.<color>");
	elseif (nRet == -1) then
		Msg2Player("<color=red>Tæ ®éi ch­a ®ñ ng­êi.<color>");
	elseif (nRet == -2) then
		Msg2Player("<color=red>Ph¹m vi ph¶i tõ 10 ®Õn 100 «.<color>");
	else
		Msg2Player("<color=red>Kh«ng bËt ®­îc (m· " .. nRet .. ").<color>");
	end;
end;

function LenhBaiChiHuy_Disable()
	TeamCall_DisablePermanent();
	Msg2Player("<color=yellow>§· t¾t gäi tù ®éng.<color>");
end;
