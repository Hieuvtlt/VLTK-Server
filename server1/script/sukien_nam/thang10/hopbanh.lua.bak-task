function main(nItemIdx)
	local TSK_TONG_EXP = 1312
	local TSK_NAM_EVENT = 1311
	local MAX_EXP = 1500000000
	local nMonth = tonumber(GetLocalDate("%m"))
	local nYear = tonumber(GetLocalDate("%Y"))

	-- KI?M TRA H?N S? D?NG
	if nMonth ~= 10 then
		Msg2Player("<color=red>Hép B¸nh Trung Thu ®· hÕt h¹n, bÞ «i thiu vµ ®· bÞ vøt bá!<color>")
		return 1
	end

	local nNamCu = GetTask(TSK_NAM_EVENT)
	if nNamCu ~= nYear then
		SetTask(TSK_TONG_EXP, 0) 
		SetTask(TSK_NAM_EVENT, nYear) 
	end

	local nExpDaNhan = GetTask(TSK_TONG_EXP)
	if nExpDaNhan >= MAX_EXP then
		Msg2Player("<color=red>§¹i hiÖp ®· nhËn tèi ®a 1.5 Tû Kinh NghiÖm tõ Hép B¸nh, kh«ng thÓ dïng thªm!<color>")
		return 1
	end

	if CalcFreeItemCellCount() < 2 then
		Msg2Player("Hµnh trang cÇn Ýt nhÊt 2 « trèng ®Ó nhËn th­ëng!")
		return 1
	end

	local nG, nD, nP = GetItemProp(nItemIdx)
	if ConsumeEquiproomItem(1, nG, nD, nP, -1) ~= 1 then
		Msg2Player("HÖ thèng bËn, kh«ng thÓ sö dông vËt phÈm lóc nµy!")
		return 1
	end

	-- C?NG 10 TRI?U EXP
	local nAddExp = 10000000
	if nExpDaNhan + nAddExp > MAX_EXP then nAddExp = MAX_EXP - nExpDaNhan end
	
	tl_addPlayerExp(nAddExp)
	SetTask(TSK_TONG_EXP, nExpDaNhan + nAddExp)
	
	tbAwardTemplet:GiveAwardByList(tb_QuaTrungThu, "Hép B¸nh Trung Thu")
	Msg2Player("<color=yellow>Sö dông thµnh c«ng, nhËn ®­îc 1000 v¹n Kinh NghiÖm vµ phÇn quµ bÊt ngê!<color>")
	return 1
end