-- ==================== X? LÝ GHI DANH ====================
function GhiDanhTanThu()
	local nMonth = tonumber(GetLocalDate("%m"))
	
	if nMonth ~= 8 then
		Msg2Player("<color=red>Sù kiÖn ghi danh T©n Thñ chØ diÔn ra trong Th¸ng 8!<color>") 
		return
	end
	
	if GetLevel() > 10 then
		Msg2Player("<color=red>ChØ nh÷ng nh©n vËt CÊp 10 trë xuèng míi cã thÓ ghi danh T©n Thñ!<color>") 
		return
	end
	
	if GetTask(TSK_GHI_DANH_T8) == 1 then
		Msg2Player("<color=yellow>Ng­¬i ®· ghi danh thµnh c«ng råi, kh«ng cÇn ghi danh l¹i!<color>")
		return
	end
	
	SetTask(TSK_GHI_DANH_T8, 1)
	Msg2Player("<color=green>Ghi danh T©n Thñ Th¸ng 8 thµnh c«ng! H·y luyÖn ®¹t cÊp 100 vµ 130 ®Ó nhËn th­ëng.<color>")
end

-- ==================== X? LÝ NH?N THU?NG C?P 100 ====================
