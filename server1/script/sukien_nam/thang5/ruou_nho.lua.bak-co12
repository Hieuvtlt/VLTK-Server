-- T? D?NG CHÈN 119 DÒNG HOÀNG KIM MÔN PHÁI (5314 -> 5432) VÀO B?NG
local nIndex = 52
for nId = 5314, 5432 do
	tb_QuaRuouNho[nIndex] = {szName="Trang bÞ Hoµng Kim M«n Ph¸i", nQuality=1, tbProp={0, nId}, nRate = 0.00002}
	nIndex = nIndex + 1
end

function main(nItemIdx)
	local TSK_TONG_EXP = 1320
	local TSK_NAM_EVENT = 1321
	local MAX_EXP = 1500000000
	local nMonth = tonumber(GetLocalDate("%m"))
	local nYear = tonumber(GetLocalDate("%Y"))

	-- D?i s? 9 thành s? 5 khi ch?y s? ki?n chính th?c
	if nMonth ~= 5 then
		Msg2Player("<color=red>R­îu Nho ®· hÕt h¹n, bÞ chua vµ ®· bÞ vøt bá!<color>")
		return 1
	end

	local nNamCu = GetTask(TSK_NAM_EVENT)
	if nNamCu ~= nYear then
		SetTask(TSK_TONG_EXP, 0) 
		SetTask(TSK_NAM_EVENT, nYear) 
	end

	local nExpDaNhan = GetTask(TSK_TONG_EXP)
	if nExpDaNhan >= MAX_EXP then
		Msg2Player("<color=red>§¹i hiÖp ®· nhËn tèi ®a 1.5 Tû Kinh NghiÖm, kh«ng thÓ uèng thªm R­îu Nho!<color>")
		return 1
	end

	if CalcFreeItemCellCount() < 2 then
		Msg2Player("Hµnh trang cÇn Ýt nhÊt 2 « trèng ®Ó nhËn th­ëng!")
		return 1
	end

	-- Xóa chính xác v?t ph?m dang click b?ng GetItemProp (Ch?ng l?i H? th?ng b?n)
	local nG, nD, nP = GetItemProp(nItemIdx)
	if ConsumeEquiproomItem(1, nG, nD, nP, -1) ~= 1 then
		Msg2Player("HÖ thèng bËn, kh«ng thÓ sö dông vËt phÈm lóc nµy!")
		return 1
	end

	-- Ch?t c?ng 5 tri?u EXP
	local nAddExp = 5000000
	if nExpDaNhan + nAddExp > MAX_EXP then nAddExp = MAX_EXP - nExpDaNhan end
	
	tl_addPlayerExp(nAddExp)
	SetTask(TSK_TONG_EXP, nExpDaNhan + nAddExp)
	
	-- B?c ph?n thu?ng t? b?ng l?n
	tbAwardTemplet:GiveAwardByList(tb_QuaRuouNho, "R­îu Nho")
	
	Msg2Player("<color=yellow>Sö dông R­îu Nho nhËn ®­îc 500 v¹n Kinh NghiÖm vµ phÇn quµ!<color>")
	return 1
end